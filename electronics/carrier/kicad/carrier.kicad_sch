(text "A diode guards against reversed 24 V. The buck feeds the matrix and the logic." (at 25.4 34.29 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c1ef29a8-9617-5aed-8cf9-b8dbe33410d8"))

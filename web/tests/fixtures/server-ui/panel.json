[
  {
    "kind": "header",
    "text": [
      {
        "text": "Simulation"
      }
    ]
  },
  {
    "kind": "text",
    "text": [
      {
        "text": "What the "
      },
      {
        "text": "simulated",
        "italic": true
      },
      {
        "text": " camera sees. See "
      },
      {
        "text": "the guide",
        "href": "https://example.org/guide"
      },
      {
        "text": "."
      }
    ]
  },
  {
    "kind": "bullets",
    "items": [
      [
        {
          "text": "Changes apply at once."
        }
      ],
      [
        {
          "text": "Defaults",
          "bold": true
        },
        {
          "text": " aren't highlighted."
        }
      ]
    ]
  },
  {
    "kind": "property_control",
    "thing": "camera",
    "property": "exposure_time",
    "label": "Exposure (µs)",
    "step": 100.0,
    "read_back_ms": 500
  },
  {
    "kind": "container",
    "layout": "row",
    "children": [
      {
        "kind": "property_control",
        "thing": "camera",
        "property": "repeating",
        "label": "Repeating sample"
      },
      {
        "kind": "property_control",
        "thing": "camera",
        "property": "objective",
        "label": "Objective",
        "options": [
          {
            "label": "10×",
            "value": 10
          },
          {
            "label": "40×",
            "value": 40
          }
        ]
      }
    ]
  },
  {
    "kind": "accordion",
    "title": "More",
    "children": [
      {
        "kind": "property_control",
        "thing": "camera",
        "property": "settling_time",
        "label": "Settling time",
        "input": "duration_hms"
      },
      {
        "kind": "property_control",
        "thing": "camera",
        "property": "colour",
        "label": "Colours"
      },
      {
        "kind": "property_control",
        "thing": "camera",
        "property": "no_such_property",
        "label": "Missing",
        "broken": true
      }
    ]
  },
  {
    "kind": "container",
    "layout": "row",
    "children": [
      {
        "kind": "action_button",
        "thing": "camera",
        "action": "settle",
        "label": "Settle",
        "confirm": "Wait for the camera to settle?",
        "progress": "dialog",
        "stream": "camera",
        "success": {
          "message": "Settled."
        },
        "refresh": true
      },
      {
        "kind": "action_button",
        "thing": "camera",
        "action": "capture_to_memory",
        "label": "Capture",
        "input": {
          "buffer_max": 2
        },
        "cancellable": false,
        "success": "output",
        "secondary": true
      },
      {
        "kind": "action_button",
        "thing": "camera",
        "action": "no_such_action",
        "label": "Missing",
        "broken": true
      }
    ]
  },
  {
    "kind": "container",
    "layout": "row",
    "children": [
      {
        "kind": "download_button",
        "label": "Download a frame",
        "source": "action",
        "thing": "camera",
        "action": "grab_jpeg",
        "input": {
          "stream_name": "lores"
        },
        "filename": "frame.jpg"
      },
      {
        "kind": "download_button",
        "label": "Download settings",
        "source": "endpoint",
        "thing": "camera",
        "path": "settings.json",
        "filename": "camera.json",
        "secondary": true,
        "broken": true
      }
    ]
  }
]
